# ─────────────────────────────────────────────────────────────────────────────
# RareDiseaseCF — Environment configuration
# Copy this file to .env and adjust values as needed.
# Full reference: docs/ENV.md
# Do not commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend / Solana (public — never put private keys here) ─────────────────
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet
VITE_PROGRAM_ID=3ChG4eL5EvhrELWbAZs3cdVt8P9X1CfrRwfF6gqfKG9d
# Official Circle Devnet USDC:
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── API server ───────────────────────────────────────────────────────────────
PORT=8787
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=rdcf_session
SESSION_TTL_HOURS=24
CHALLENGE_TTL_MINUTES=5

# ── PostgreSQL + encryption (required) ───────────────────────────────────────
DATABASE_URL=postgresql://rdcf_dev:rdcf_dev_password@localhost:5432/rarediseasecf_dev
CASE_ACCESS_COOKIE_NAME=rdcf_case_access
CASE_ACCESS_TTL_DAYS=30
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=local-dev-v1

# ── Reviewer / provider / hospital bootstrap ─────────────────────────────────
REVIEWER_SESSION_COOKIE_NAME=rdcf_reviewer_session
REVIEWER_SESSION_TTL_HOURS=8
REVIEWER_BOOTSTRAP_WALLETS=
PROVIDER_BOOTSTRAP_RECORDS=[]
HOSPITAL_WHITELIST_BOOTSTRAP=[]
# CASE_UPLOAD_DIR=

# ── Hospital magic-link + optional SMTP ──────────────────────────────────────
# MAGIC_LINK_HMAC_SECRET=
MAGIC_LINK_TTL_HOURS=24
ADMIN_SECRET=rdcf-demo-admin
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@rarediseasecf.demo

# Production switches (default: on in production, off in dev)
# RATE_LIMIT_ENABLED=true
# LEGACY_REVIEWER_ENABLED=false
# VITE_PRIVACY_CONTACT_EMAIL=privacy@yourdomain.org

# ── On-chain escrow (REQUIRED) — SERVER ONLY, never VITE_* ───────────────────
# The API will not start without these. Must match VITE_SOLANA_NETWORK / VITE_USDC_MINT.
SOLANA_CLUSTER=devnet              # devnet | mainnet-beta
# SOLANA_RPC_URL=https://api.devnet.solana.com
# PROGRAM_ID=3ChG4eL5EvhrELWbAZs3cdVt8P9X1CfrRwfF6gqfKG9d
# Devnet USDC: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU · Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Platform key = program admin + registered verifier. JSON array or base58.
PLATFORM_AUTHORITY_SECRET_KEY=
# EXPIRY_SWEEP_INTERVAL_MINUTES=60
