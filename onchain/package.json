{
  "name": "rarediseasecf-onchain",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "lint:fix": "prettier --check \"tests/**/*.ts\"",
    "check:privacy": "node ./scripts/check-privacy-surface.mjs",
    "check:host": "cargo check -p rarediseasecf && cargo test -p rarediseasecf --lib",
    "fmt:check": "cargo fmt --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "diagnose:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/diagnose-windows-sbf.ps1",
    "validate:linux-docker": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-linux-docker.ps1",
    "test": "anchor test"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "uuid": "8.3.2",
    "rpc-websockets": {
      "uuid": "8.3.2"
    }
  }
}
