{
  "name": "raredisease",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start:server": "tsx server/index.ts",
    "test:server": "tsx --test server/config.test.ts server/hospitals/testHospital.test.ts server/auth/authService.test.ts server/cases/caseValidation.test.ts server/cases/coverImage.test.ts server/reviewer/approvalValidation.test.ts server/campaigns/publicCampaignSerializer.test.ts server/campaigns/publicCampaignRoutes.test.ts server/hospitals/day1.foundation.test.ts server/hospitals/day10.security.test.ts server/hospitals/magicLink.test.ts server/hospitals/payoutValidation.test.ts server/escrow/escrowService.test.ts server/milestones/milestoneState.test.ts server/chain/solanaRelayer.test.ts server/middleware/rateLimit.test.ts",
    "smoke:case": "tsx server/cases/httpCase.smoke.ts",
    "smoke:hospital": "tsx server/hospitals/httpHospitalVerify.smoke.ts",
    "smoke:donate": "tsx server/donations/httpDonation.smoke.ts",
    "onchain:check": "cd onchain && cargo check -p rarediseasecf",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@noble/hashes": "^2.4.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "@vercel/blob": "^2.8.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^11.1.0"
    }
  }
}
